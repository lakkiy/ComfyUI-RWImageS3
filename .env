# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------
# First S3 key set (required)
# ---------------------------------------------------------------
# Name shown in the node's s3_source dropdown (default: "default")
S3_NAME=aws
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=us-east-1
S3_BUCKET=your-bucket
# Optional: custom S3-compatible endpoint (R2, MinIO, ...)
# S3_ENDPOINT_URL=https://your-endpoint

# ---------------------------------------------------------------
# More key sets (optional): S3_2_*, S3_3_*, ...
# "auto" in Read Image From S3 tries them in order: first set, S3_2, S3_3, ...
# ---------------------------------------------------------------
# S3_2_NAME=r2
# S3_2_ACCESS_KEY_ID=...
# S3_2_SECRET_ACCESS_KEY=...
# S3_2_REGION=auto
# S3_2_BUCKET=your-r2-bucket
# S3_2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# S3_3_NAME=minio
# S3_3_ACCESS_KEY_ID=...
# S3_3_SECRET_ACCESS_KEY=...
# S3_3_BUCKET=your-minio-bucket
# S3_3_ENDPOINT_URL=http://localhost:9000
